{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-score",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "review.falsita.cn/*", "zone_name": "falsita.cn" }
  ],
  "vars": {
    "AUTH_APP_ORIGIN": "https://review.falsita.cn"
  },
  "secrets": {
    "required": ["OIDC_CLIENT_ID", "OIDC_CLIENT_SECRET", "AUTH_SESSION_KEY"]
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTH_SESSIONS", "class_name": "ScoreAuthSession" }]
  },
  "migrations": [
    { "tag": "auth-v1", "new_sqlite_classes": ["ScoreAuthSession"] }
  ],
  "ratelimits": [
    { "name": "AUTH_LOGIN_LIMIT", "namespace_id": "3567142981", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-score",
      "database_id": "89dfb81b-4114-4a1c-9e5a-f3ca08b6e191",
      "migrations_dir": "migrations"
    }
  ]
}
